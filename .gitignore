# ==============================================================================
# TinyKey .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 构建产物
# ------------------------------------------------------------------------------
# EIDE 输出目录（MDK-ARM/.gitignore 中另有 /build 规则）
MDK-ARM/build/
tests/build/

# Keil MDK 编译中间文件与产物
*.o
*.d
*.crf
*.axf
*.elf
*.hex
*.bin
*.sct
*.lnp
*.map
*.lst
*.dep
*.iex
*.htm
*.build_log.htm
*.bak
*.ddk
*.edk
*.ln
*.plg
*.tra
*.uvguix.*
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/DebugConfig/

# Keil 本地用户配置（断点、窗口布局、下载器设置），不进版本库
*.uvoptx
*.uvopt.bak
*.uvproj.bak

# Keil RTE 自动生成
MDK-ARM/RTE/
MDK-ARM/RTE_Components.h

# ------------------------------------------------------------------------------
# 体积大且可重新获取的工具链缓存 / 第三方包
#   .pack  : Keil STM32F1xx_DFP 器件包（约 77 MB）
#   .cmsis : EIDE 从器件包解出的 CMSIS 头文件缓存（约 4 MB）
# 克隆后由 EIDE / Keil 自动重新获取，无需入库
# ------------------------------------------------------------------------------
MDK-ARM/.pack/
MDK-ARM/.cmsis/

# ------------------------------------------------------------------------------
# EIDE 本地状态（eide.yml / files.options.yml 属工程配置，需要入库）
# ------------------------------------------------------------------------------
MDK-ARM/.eide/log/
MDK-ARM/.eide.usr.ctx.json

# ------------------------------------------------------------------------------
# 编辑器 / 操作系统
# ------------------------------------------------------------------------------
.vscode/launch.json
.settings/
Thumbs.db
desktop.ini
